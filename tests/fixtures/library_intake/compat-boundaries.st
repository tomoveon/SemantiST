FUNCTION COMPAT_BOUNDARY_TEST : DINT
    COMPAT_BOUNDARY_TEST := 0;
    IF TIME_TO_DWORD(TIME#0ns) <> DWORD#0 THEN COMPAT_BOUNDARY_TEST := 1; RETURN; END_IF;
    IF TIME_TO_DWORD(TIME#999999ns) <> DWORD#0 THEN COMPAT_BOUNDARY_TEST := 2; RETURN; END_IF;
    IF TIME_TO_DWORD(TIME#1ms) <> DWORD#1 THEN COMPAT_BOUNDARY_TEST := 3; RETURN; END_IF;
    IF TIME_TO_DWORD(TIME#1ms999999ns) <> DWORD#1 THEN COMPAT_BOUNDARY_TEST := 4; RETURN; END_IF;
    IF TIME_TO_DWORD(DWORD_TO_TIME(DWORD#16#FFFFFFFF)) <> DWORD#16#FFFFFFFF THEN COMPAT_BOUNDARY_TEST := 5; RETURN; END_IF;
    IF DATE_TO_DWORD(DATE#1970-01-01) <> DWORD#0 THEN COMPAT_BOUNDARY_TEST := 6; RETURN; END_IF;
    IF DATE_TO_DWORD(LINT_TO_DATE(LINT#999999999)) <> DWORD#0 THEN COMPAT_BOUNDARY_TEST := 7; RETURN; END_IF;
    IF DATE_TO_DWORD(DATE#2106-02-07) <> DWORD#4294944000 THEN COMPAT_BOUNDARY_TEST := 8; RETURN; END_IF;
    IF DATE_TO_DWORD(DWORD_TO_DATE(DWORD#16#FFFFFFFF)) <> DWORD#16#FFFFFFFF THEN COMPAT_BOUNDARY_TEST := 9; RETURN; END_IF;
    IF DATE_TO_UDINT(DATE#2106-02-07) <> UDINT#4294944000 THEN COMPAT_BOUNDARY_TEST := 10; RETURN; END_IF;
    IF TIME_TO_DWORD(REAL_TO_TIME(REAL#1.234)) <> DWORD#1 THEN COMPAT_BOUNDARY_TEST := 11; RETURN; END_IF;
END_FUNCTION
