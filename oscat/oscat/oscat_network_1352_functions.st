		aw_aktiv := TRUE;
		step_2 := 10; (* Daten schreiben *)
		(* ---------------- Debug-Message -----------------------*)
		(*IF _debug_enable THEN
			LOG_CL.NEW_MSG := 'FILE_HTML2 - AutoWrite: [~2]';
			LOG_CL.PRINTF[2] := DT_TO_STRING(DTI);
