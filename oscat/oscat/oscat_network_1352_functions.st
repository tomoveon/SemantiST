	STATE : BOOL;
	OFF : STRING;
	ON : STRING;
	COLUMN : STRING(40);
	DELTA : BOOL;
END_VAR
VAR_OUTPUT
END_VAR
VAR
	UCB : UNI_CIRCULAR_BUFFER;
	id : WORD;
	last_delta : BOOL;
	state_last: BOOL;
