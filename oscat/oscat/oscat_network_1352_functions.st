		FB_LOG_MESSAGE();
	END_IF;*)
	(* -----------------------------------------------------------------*)
END_IF;

(* ------------ File Remove ------------- *)
IF command = 7 THEN
	error := NOT SysFileDelete(FSD.FILENAME);
	error_code := SEL(error,0,command);
	command := 0;
