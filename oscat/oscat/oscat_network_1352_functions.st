(* Source object: Project(Project=73, stPath=C:\Users\32846\CODESYS OSCAT Network\1.3.5.2\oscat_network_1352.library)/POUs/OTHER/ELEMENT_COUNT *)
(* Object kind: FUNCTION *)
(* ========================================================================== *)
FUNCTION ELEMENT_COUNT : INT
VAR_INPUT
	SEP : BYTE;
END_VAR
VAR_IN_OUT
	ELEMENT : STRING(ELEMENT_LENGTH);
END_VAR
VAR
	pt : POINTER TO ARRAY[1..ELEMENT_LENGTH] OF BYTE;
	l: INT;
	pos: INT;
END_VAR

(*
version 1.0	05. apr. 2011
programmer 	hugo
tested by		oscat

ELEMENT_COUNT liefert die anzahl der elemente einer liste.
die liste liegt als string von elementen vor die mit den zeichen SEP separiert sind.

*)

IF ELEMENT = '' THEN
	ELEMENT_COUNT := 0;
ELSE
	PT := ADR(ELEMENT);
	ELEMENT_COUNT := 1;
	l := LEN(ELEMENT);
	FOR pos := 1 TO l DO
		IF pt^[pos] = SEP THEN ELEMENT_COUNT := ELEMENT_COUNT + 1; END_IF;
	END_FOR;
END_IF;

