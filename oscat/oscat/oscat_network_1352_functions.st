(* Source object: Project(Project=73, stPath=C:\Users\32846\CODESYS OSCAT Network\1.3.5.2\oscat_network_1352.library)/POUs/CONVERT/IP4_DECODE *)
(* Object kind: FUNCTION *)
(* ========================================================================== *)
FUNCTION IP4_DECODE : DWORD
VAR_INPUT
	str : STRING(15);
END_VAR
VAR
	pos: INT;
END_VAR

(*
version 1.1	10. mar 2009
programmer 	kurt
tested by		hugo

IP4_DECODE testet ob ein string eine gültige IPv4 Adresse enthält und gibt die 4 Bytes der IP Adresse als DWORD zurück.

*)

pos := FIND(str, '.');
WHILE pos > 0 DO
	IP4_DECODE := SHL(IP4_DECODE,8) OR STRING_TO_DWORD(LEFT(str,pos - 1));
	str := DELETE(str, pos, 1);
	pos := FIND(str, '.');
END_WHILE;
IP4_DECODE := SHL(IP4_DECODE,8) OR STRING_TO_DWORD(str);


(* revision history
hm		29. feb 2008	rev 1.0
	original version

hm	10. mar. 2009	rev 1.1
	new algorythm
*)
END_FUNCTION

