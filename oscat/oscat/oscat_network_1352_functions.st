(* Source object: Project(Project=73, stPath=C:\Users\32846\CODESYS OSCAT Network\1.3.5.2\oscat_network_1352.library)/POUs/DRIVER/IRTRANS_RCV_4 *)
(* Object kind: FUNCTION_BLOCK *)
(* ========================================================================== *)
FUNCTION_BLOCK IRTRANS_RCV_4
VAR_INPUT CONSTANT
	DEV_CODE : STRING;
	KEY_CODE_0 : STRING;
	KEY_CODE_1 : STRING;
	KEY_CODE_2 : STRING;
	KEY_CODE_3 : STRING;
END_VAR
VAR_INPUT
	CMD : BOOL;
END_VAR
VAR_IN_OUT
	DEV : STRING;
	KEY : STRING;
END_VAR
VAR_OUTPUT
	Q0, Q1, Q2, Q3 : BOOL;
END_VAR
VAR_TEMP
	decode: BOOL;
END_VAR

(*

version 1.3	06. dec. 2009
programmer 	hugo
tested BY	oscat

*)

decode := cmd AND dev_code = dev;

Q0 := key = key_code_0 AND decode;
Q1 := key = key_code_1 AND decode;
Q2 := key = key_code_2 AND decode;
Q3 := key = key_code_3 AND decode;



