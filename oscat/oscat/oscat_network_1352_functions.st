				LOG_CL.PRINTF[3] := CHR_TO_STRING(DATA);
				LOG_MSG();
			END_IF;*)
			(* -----------------------------------------------------------------*)
		END_IF;
	END_IF;

10:	IF FSD.MODE = 0 THEN (* Befehl beendet *)
		IF FSD.ERROR > 0 THEN
			ERROR := FSD.ERROR; (* Fehler ausgeben *)
			MODE := 0;
		ELSE
			data_start := POS;
			data_stop := POS + UINT_TO_UDINT(PT.SIZE) - 1;
		END_IF;
		step := 0;
	END_IF;
END_CASE;

