(* Source object: Project(Project=73, stPath=C:\Users\32846\CODESYS OSCAT Network\1.3.5.2\oscat_network_1352.library)/POUs/DATA_LOG/DLOG_STRING *)
(* Object kind: FUNCTION_BLOCK *)
(* ========================================================================== *)
FUNCTION_BLOCK DLOG_STRING
VAR_IN_OUT
	X : DLOG_DATA;
END_VAR
VAR_INPUT
	STR : STRING;
	COLUMN : STRING(40);
END_VAR
VAR_OUTPUT
END_VAR
VAR
	UCB : UNI_CIRCULAR_BUFFER;
	id : WORD;
	str_last : STRING;
END_VAR

(*
version 1.3		19. apr. 2012
programmer		ks
tested by		ks

DLOG_STRING legt den STRING im FIFO-RING-Buffer ab um diesen mit den Baustein DLOG_STORE_*  aufzuzeichnen
*)

CASE x.ADD_COM OF

01:	(* ADD INFO *)
	X.ID_MAX := X.ID_MAX + USINT#1;
	id := WORD#16#0101; (* Quelltype STRING , Zieltype STRING *)
02:	(* ADD HEADER *)
	X.UCB.D_STRING := COLUMN;
	X.UCB.D_HEAD := id;
	X.UCB.D_MODE := 1;
	UCB(DATA:=X.UCB); (* Daten eintragen *)
03:	(* ADD DATA *)
	X.UCB.D_STRING := str_last;
	X.UCB.D_HEAD := id;
	X.UCB.D_MODE := 1;
	UCB(DATA:=X.UCB); (* Daten eintragen *)
END_CASE;
str_last := STR;

(* revision history
