(* Source object: Project(Project=73, stPath=C:\Users\32846\CODESYS OSCAT Network\1.3.5.2\oscat_network_1352.library)/POUs/CONVERT/URL_DECODE *)
(* Object kind: FUNCTION *)
(* ========================================================================== *)
FUNCTION URL_DECODE : STRING(OSCAT_BASIC.STRING_LENGTH)
VAR_INPUT
	IN : STRING(OSCAT_BASIC.STRING_LENGTH);
END_VAR
VAR
	pos : INT;
	seq : STRING(3);
	new : STRING(1);
END_VAR


(*
version 1.2		10. may. 2010
programmer 	hugo
tested by		hugo

URL_DECODE checks a string if it contains non reserved characters represented by a % followed with the two digit hex code and converts them to their ascii code.
the non reserved characters are : [A..Z], [a..z], [0..9], -_.~
for example the character sequence '%23' will be converted to '#'.

*)

URL_DECODE := IN;
pos := FIND(URL_DECODE,'%');
WHILE pos > 0 DO
	seq := MID(URL_DECODE,2,pos + 1);
	new := OSCAT_BASIC.CHR_TO_STRING(DWORD_TO_BYTE(OSCAT_BASIC.HEX_TO_DWORD(seq)));
	URL_DECODE := REPLACE(URL_DECODE, new, 3, pos);
	pos := FIND(URL_DECODE,'%');
END_WHILE;


