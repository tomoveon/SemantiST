FUNCTION_BLOCK DLOG_STORE_MYSQL
VAR_IN_OUT
	SQL_INFO : MYSQL_INFO;
	X : DLOG_DATA;
END_VAR
VAR_INPUT
	ENABLE : BOOL;
	TRIG_M : BOOL;
	TRIG_T : TIME;
	DTI : DT;
	URL : STRING(OSCAT_BASIC.STRING_LENGTH);
