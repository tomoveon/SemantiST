	PT^ := tmp + SEL(tmp <= 9,87,48);
	pt := pt + 1; (* decrement the pointer *)
	tmp := SHA1[i] AND 2#1111;
	PT^ := tmp + SEL(tmp <= 9,87,48);
	pt := pt + 1; (* decrement the pointer *)
END_FOR;
pt^:= 0; (* write the closing byte for the string *)

