(* ------------ File Size ------------- *)
IF command = 8 THEN
	file_size := SysFileGetSize(FSD.FILENAME);
	error_code := 0; (* kein Errorcode vorhanden *)
	command := 0;
	FSR(MODE:=BYTE#1,COMMAND:=command,FSD:=FSD); (* File server Runtime / Befehlstop überwachen *)
	(* ---------------- Debug-Message -----------------------*)
