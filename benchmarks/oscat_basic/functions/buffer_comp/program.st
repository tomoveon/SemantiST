PROGRAM PLC_PRG
VAR_INPUT
    PT1 : REF_TO ARRAY[0..32767] OF BYTE;
    SIZE1 : INT;
    PT2 : REF_TO ARRAY[0..32767] OF BYTE;
    SIZE2 : INT;
    START : INT;
END_VAR
VAR
    semantist_result : INT;
END_VAR
semantist_result := BUFFER_COMP(PT1 := PT1, SIZE1 := SIZE1, PT2 := PT2, SIZE2 := SIZE2, START := START);
END_PROGRAM
