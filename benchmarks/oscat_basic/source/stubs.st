(* OSCAT/CODESYS semantic adapters for RuSTy's nanosecond temporal storage.

   CODESYS TIME/TOD use unsigned 32-bit milliseconds; DATE/DT use unsigned
   32-bit seconds since 1970-01-01. RuSTy represents temporal values as signed
   64-bit nanoseconds. Each adapter changes representation explicitly and then
   delegates narrowing/rounding to pinned RuSTy IEC conversion primitives.

   These are library compatibility functions, not Harness implementations.
*)

FUNCTION STRING_TO_INT : INT
VAR_INPUT IN : STRING; END_VAR
    STRING_TO_INT := DINT_TO_INT(STRING_TO_DINT(IN));
END_FUNCTION

FUNCTION INT_TO_STRING : STRING
VAR_INPUT IN : INT; END_VAR
    INT_TO_STRING := DINT_TO_STRING(INT_TO_DINT(IN));
END_FUNCTION

FUNCTION UDINT_TO_DT : DT
VAR_INPUT IN : UDINT; END_VAR
    UDINT_TO_DT := ULINT_TO_DT(UDINT_TO_ULINT(IN) * ULINT#1000000000);
END_FUNCTION

FUNCTION DWORD_TO_TOD : TOD
VAR_INPUT IN : DWORD; END_VAR
    DWORD_TO_TOD := ULINT_TO_TOD(DWORD_TO_ULINT(IN) * ULINT#1000000);
END_FUNCTION

FUNCTION DT_TO_UDINT : UDINT
VAR_INPUT IN : DT; END_VAR
    DT_TO_UDINT := LINT_TO_UDINT(DT_TO_LINT(IN) / LINT#1000000000);
END_FUNCTION

FUNCTION DWORD_TO_DT : DT
VAR_INPUT IN : DWORD; END_VAR
    DWORD_TO_DT := ULINT_TO_DT(DWORD_TO_ULINT(IN) * ULINT#1000000000);
END_FUNCTION

FUNCTION TIME_TO_INT : INT
VAR_INPUT IN : TIME; END_VAR
    TIME_TO_INT := LINT_TO_INT(TIME_TO_LINT(IN) / LINT#1000000);
END_FUNCTION

FUNCTION TOD_TO_DWORD : DWORD
VAR_INPUT IN : TOD; END_VAR
    TOD_TO_DWORD := LINT_TO_DWORD(TOD_TO_LINT(IN) / LINT#1000000);
END_FUNCTION

FUNCTION DWORD_TO_DATE : DATE
VAR_INPUT IN : DWORD; END_VAR
    DWORD_TO_DATE := ULINT_TO_DATE(DWORD_TO_ULINT(IN) * ULINT#1000000000);
END_FUNCTION

FUNCTION DATE_TO_UDINT : UDINT
VAR_INPUT IN : DATE; END_VAR
    DATE_TO_UDINT := LINT_TO_UDINT(DATE_TO_LINT(IN) / LINT#1000000000);
END_FUNCTION

FUNCTION UDINT_TO_DATE : DATE
VAR_INPUT IN : UDINT; END_VAR
    UDINT_TO_DATE := ULINT_TO_DATE(UDINT_TO_ULINT(IN) * ULINT#1000000000);
END_FUNCTION

FUNCTION DINT_TO_TOD : TOD
VAR_INPUT IN : DINT; END_VAR
    DINT_TO_TOD := ULINT_TO_TOD(UDINT_TO_ULINT(DINT_TO_UDINT(IN)) * ULINT#1000000);
END_FUNCTION

FUNCTION TOD_TO_DINT : DINT
VAR_INPUT IN : TOD; END_VAR
    TOD_TO_DINT := DWORD_TO_DINT(LINT_TO_DWORD(TOD_TO_LINT(IN) / LINT#1000000));
END_FUNCTION

FUNCTION DATE_TO_DWORD : DWORD
VAR_INPUT IN : DATE; END_VAR
    DATE_TO_DWORD := LINT_TO_DWORD(DATE_TO_LINT(IN) / LINT#1000000000);
END_FUNCTION

FUNCTION BYTE_TO_REAL : REAL
VAR_INPUT IN : BYTE; END_VAR
    BYTE_TO_REAL := UDINT_TO_REAL(BYTE_TO_UDINT(IN));
END_FUNCTION

FUNCTION WORD_TO_REAL : REAL
VAR_INPUT IN : WORD; END_VAR
    WORD_TO_REAL := UDINT_TO_REAL(WORD_TO_UDINT(IN));
END_FUNCTION

FUNCTION TIME_TO_DINT : DINT
VAR_INPUT IN : TIME; END_VAR
    TIME_TO_DINT := LINT_TO_DINT(TIME_TO_LINT(IN) / LINT#1000000);
END_FUNCTION

FUNCTION REAL_TO_TIME : TIME
VAR_INPUT IN : REAL; END_VAR
    REAL_TO_TIME := ULINT_TO_TIME(UDINT_TO_ULINT(REAL_TO_UDINT(IN)) * ULINT#1000000);
END_FUNCTION

FUNCTION DT_TO_DWORD : DWORD
VAR_INPUT IN : DT; END_VAR
    DT_TO_DWORD := LINT_TO_DWORD(DT_TO_LINT(IN) / LINT#1000000000);
END_FUNCTION

FUNCTION DWORD_TO_TIME : TIME
VAR_INPUT IN : DWORD; END_VAR
    DWORD_TO_TIME := ULINT_TO_TIME(DWORD_TO_ULINT(IN) * ULINT#1000000);
END_FUNCTION

FUNCTION TIME_TO_DWORD : DWORD
VAR_INPUT IN : TIME; END_VAR
    TIME_TO_DWORD := LINT_TO_DWORD(TIME_TO_LINT(IN) / LINT#1000000);
END_FUNCTION

FUNCTION TIME_TO_REAL : REAL
VAR_INPUT IN : TIME; END_VAR
    TIME_TO_REAL := LINT_TO_REAL(TIME_TO_LINT(IN) / LINT#1000000);
END_FUNCTION
