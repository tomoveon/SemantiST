(* Approximate offline dependencies for exported OSCAT Network POUs. *)

FUNCTION STRING_TO_DWORD : DWORD
VAR_INPUT IN : STRING; END_VAR
    STRING_TO_DWORD := LINT_TO_DWORD(STRING_TO_LINT(IN));
END_FUNCTION

TYPE URL :
STRUCT
    PROTOCOL : STRING[20];
    USER : STRING[64];
    PASSWORD : STRING[64];
    DOMAIN : STRING[255];
    PORT : WORD;
    PATH : STRING[255];
    QUERY : STRING[255];
    ANCHOR : STRING[64];
END_STRUCT
END_TYPE

TYPE FILE_SERVER_DATA :
STRUCT
    FILENAME : STRING[255];
    MODE : BYTE;
    OFFSET : UDINT;
    FILE_OPEN : BOOL;
    FILE_SIZE : UDINT;
    ERROR : BYTE;
END_STRUCT
END_TYPE

TYPE FILE_PATH_DATA :
STRUCT
    FILENAME : STRING[255];
END_STRUCT
END_TYPE

TYPE MYSQL_INFO :
STRUCT
    SQL_CONNECTED : BOOL;
END_STRUCT
END_TYPE

TYPE UNI_CIRCULAR_BUFFER_DATA :
STRUCT
    D_MODE : INT;
    D_STRING : STRING[250];
    D_HEAD : WORD;
    BUF_COUNT : INT;
    BUF_DATA_LOST : BOOL;
    BUF_USED_MAX : INT;
END_STRUCT
END_TYPE

TYPE DLOG_DATA :
STRUCT
    DTI : DT;
    CLOCK_TRIG : BOOL;
    ADD_COM : INT;
    ADD_DATA_REQ : BOOL;
    STORE_TYPE : BYTE;
    ID_MAX : USINT;
    UCB : UNI_CIRCULAR_BUFFER_DATA;
END_STRUCT
END_TYPE

TYPE MYSQL_COM :
STRUCT
    SQL_URL : STRING[250];
    TIMEOUT : TIME;
    DNS_IP4 : DWORD;
    SQL_CON : BOOL;
    SQL_PACKET_NO : BYTE;
    SQL_RCV_STATE : BYTE;
    S_BUF : NETWORK_BUFFER;
    ERROR_C : DWORD;
    ERROR_T : BYTE;
END_STRUCT
END_TYPE

FUNCTION TIME_TO_UDINT : UDINT
VAR_INPUT IN : TIME; END_VAR
    TIME_TO_UDINT := LINT_TO_UDINT(TIME_TO_LINT(IN) / LINT#1000000);
END_FUNCTION

FUNCTION STRING_TO_URL : URL
VAR_INPUT
    STR : STRING[250];
    DEFAULT_PROTOCOL : STRING[10];
    DEFAULT_PATH : STRING[80];
END_VAR
    STRING_TO_URL.DOMAIN := STR;
    STRING_TO_URL.PROTOCOL := DEFAULT_PROTOCOL;
    STRING_TO_URL.PATH := DEFAULT_PATH;
END_FUNCTION

FUNCTION ELEMENT_COUNT : INT
VAR_INPUT SEP : BYTE; STR : STRING[250]; END_VAR
    IF STR = '' THEN ELEMENT_COUNT := 0; ELSE ELEMENT_COUNT := 1; END_IF;
END_FUNCTION

FUNCTION ELEMENT_GET : STRING[250]
VAR_INPUT SEP : BYTE; INDEX : INT; STR : STRING[250]; END_VAR
    IF INDEX = 0 THEN ELEMENT_GET := STR; ELSE ELEMENT_GET := ''; END_IF;
END_FUNCTION

FUNCTION FILE_PATH_SPLIT : BOOL
VAR_INPUT FILENAME : STRING[250]; END_VAR
VAR_IN_OUT X : FILE_PATH_DATA; END_VAR
    X.FILENAME := FILENAME;
    FILE_PATH_SPLIT := TRUE;
END_FUNCTION

FUNCTION_BLOCK DNS_CLIENT
VAR_INPUT
    DOMAIN : STRING[255];
    IP4_DNS : DWORD;
    ACTIVATE : BOOL;
END_VAR
VAR_IN_OUT
    IP_C : IP_C;
    S_BUF : NETWORK_BUFFER;
    R_BUF : NETWORK_BUFFER;
END_VAR
VAR_OUTPUT
    DONE : BOOL;
    ERROR : DWORD;
    IP4 : DWORD;
END_VAR
    DONE := ACTIVATE;
    IP4 := IP4_DNS;
    ERROR := DWORD#0;
END_FUNCTION_BLOCK

FUNCTION_BLOCK IP_CONTROL
VAR_INPUT
    IP : DWORD;
    PORT : WORD;
    TIME_OUT : TIME;
END_VAR
VAR_IN_OUT
    IP_C : IP_C;
    S_BUF : NETWORK_BUFFER;
    R_BUF : NETWORK_BUFFER;
END_VAR
END_FUNCTION_BLOCK

FUNCTION_BLOCK FILE_SERVER
VAR_IN_OUT
    FSD : FILE_SERVER_DATA;
    PT : NETWORK_BUFFER;
END_VAR
    FSD.ERROR := BYTE#0;
END_FUNCTION_BLOCK

FUNCTION_BLOCK BASE64_ENCODE_STR
VAR_INPUT
    RUN : BOOL;
    STR1 : STRING[144];
    STR2 : STRING[192];
END_VAR
VAR_OUTPUT DONE : BOOL; END_VAR
    DONE := RUN;
END_FUNCTION_BLOCK

FUNCTION_BLOCK BASE64_ENCODE_STREAM
VAR_INPUT
    SIZE1 : INT;
    BUF1 : ARRAY[0..47] OF BYTE;
END_VAR
VAR_OUTPUT
    BUF2 : ARRAY[0..63] OF BYTE;
    SIZE2 : INT;
END_VAR
    SIZE2 := 0;
END_FUNCTION_BLOCK

FUNCTION_BLOCK MD5_CRAM_AUTH
VAR_INPUT
    RUN : BOOL;
    USERNAME : STRING[64];
    PASSWORD : STRING[64];
    B64_TS : STRING[64];
END_VAR
VAR_OUTPUT AUTH_KEY : STRING[192]; END_VAR
    AUTH_KEY := '';
END_FUNCTION_BLOCK

FUNCTION_BLOCK UNI_CIRCULAR_BUFFER
VAR_IN_OUT DATA : UNI_CIRCULAR_BUFFER_DATA; END_VAR
    IF DATA.D_MODE = 99 THEN DATA.BUF_COUNT := 0; END_IF;
END_FUNCTION_BLOCK

FUNCTION_BLOCK MYSQL_CONTROL
VAR_IN_OUT
    COM : MYSQL_COM;
    INFO : MYSQL_INFO;
END_VAR
    INFO.SQL_CONNECTED := COM.SQL_CON;
    IF COM.SQL_CON THEN COM.SQL_RCV_STATE := BYTE#1; END_IF;
END_FUNCTION_BLOCK
