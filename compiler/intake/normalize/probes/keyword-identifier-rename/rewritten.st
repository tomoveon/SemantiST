(* OSCAT defines a FUNCTION named OVERRIDE; CODESYS has no OVERRIDE keyword. *)
FUNCTION OVERRIDE__ : REAL
VAR_INPUT
    X1, X2 : REAL;
END_VAR
OVERRIDE__ := X1;
IF ABS(X2) > ABS(OVERRIDE__) THEN OVERRIDE__ := X2; END_IF;
END_FUNCTION

FUNCTION main : DINT
printf('%d$N', REAL_TO_DINT(OVERRIDE__(2.0, -5.0)));
main := 0;
END_FUNCTION
