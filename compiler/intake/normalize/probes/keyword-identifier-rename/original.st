(* OSCAT defines a FUNCTION named OVERRIDE; CODESYS has no OVERRIDE keyword. *)
FUNCTION OVERRIDE : REAL
VAR_INPUT
    X1, X2 : REAL;
END_VAR
OVERRIDE := X1;
IF ABS(X2) > ABS(OVERRIDE) THEN OVERRIDE := X2; END_IF;
END_FUNCTION

FUNCTION main : DINT
printf('%d$N', REAL_TO_DINT(OVERRIDE(2.0, -5.0)));
main := 0;
END_FUNCTION
