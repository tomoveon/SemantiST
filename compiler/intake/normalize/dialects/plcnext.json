{
  "schema_version": "semantist.dialect-profile/1.0.0",
  "id": "plcnext",
  "version": 2,
  "family": "plcnext",
  "description": "Phoenix Contact PLCnext Engineer",
  "rules": [
    "var-block-constant",
    "array-initializer-brackets",
    "standard-name-collision-rename",
    "keyword-identifier-rename",
    "elseif-keyword"
  ],
  "identifier_words": [
    "OVERRIDE",
    "ENDIF",
    "ENDFOR",
    "ENDWHILE",
    "ENDREPEAT",
    "ENDCASE",
    "ENDVAR",
    "ENDTYPE",
    "ENDSTRUCT",
    "ENDFUNCTION",
    "ENDFUNCTIONBLOCK",
    "ENDPROGRAM",
    "ENDACTION",
    "ENDACTIONS",
    "ENDMETHOD",
    "ENDCLASS",
    "ENDINTERFACE",
    "ENDPROPERTY",
    "VARINPUT",
    "VAROUTPUT",
    "VARINOUT",
    "VARGLOBAL",
    "VARTEMP",
    "NONRETAIN",
    "REFTO",
    "PROPERTYGET",
    "PROPERTYSET"
  ],
  "compiler_args": [],
  "compatibility_profiles": []
}
