+#[cfg(all(test, feature = "semantist_vclock"))]
+mod semantist_vclock_tests {
+    use super::*;
+
+    #[no_mangle]
+    static mut __semantist_timer_semantics: u8 = 1;
+
+    static mut VCLOCK: u64 = 0;
+
+    #[no_mangle]
+    extern "C" fn __semantist_vclock_ns() -> u64 {
+        unsafe { VCLOCK }
+    }
+
+    fn advance(ns: u64) {
+        unsafe { VCLOCK += ns }
+    }
+
+    fn ton() -> TimerParams {
+        TimerParams { preset_time: 500_000_000, ..TimerParams::default() }
+    }
+
+    #[test]
+    fn deterministic_replay_and_iec_ge_boundary() {
+        unsafe { VCLOCK = 0 };
+        let mut first = ton();
+        first.input = true;
+        TON(&mut first);
+        assert!(!first.output);
+        advance(10_000_000);
+        TON(&mut first);
+        assert_eq!(first.elapsed_time, 10_000_000);
+        for _ in 0..49 {
+            advance(10_000_000);
+            TON(&mut first);
+        }
+        assert!(first.output, "Q at ET == PT under iec_ge");
+        assert_eq!(first.elapsed_time, 500_000_000);
+
+        unsafe { VCLOCK = 0 };
+        let mut second = ton();
+        second.input = true;
+        TON(&mut second);
+        for _ in 0..50 {
+            advance(10_000_000);
+            TON(&mut second);
+        }
+        assert_eq!(second.output, first.output);
+        assert_eq!(second.elapsed_time, first.elapsed_time);
+    }
+
+    #[test]
+    fn ton_zero_preset_is_true_in_the_rising_edge_scan() {
+        unsafe { VCLOCK = 0 };
+        let mut timer = TimerParams { preset_time: 0, ..TimerParams::default() };
+        timer.input = true;
+        timer.input_edge.set(false);
+        TON(&mut timer);
+        assert!(timer.output);
+    }
+}
