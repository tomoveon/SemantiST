+#[cfg(feature = "semantist_vclock")]
+mod semantist_vclock {
+    use std::time::Duration;
+
+    extern "C" {
+        fn __semantist_vclock_ns() -> u64;
+        static __semantist_timer_semantics: u8;
+    }
+
+    #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+    pub struct Instant {
+        ns: u64,
+    }
+
+    impl Instant {
+        pub fn now() -> Self {
+            Self { ns: unsafe { __semantist_vclock_ns() } }
+        }
+
+        pub fn elapsed(&self) -> Duration {
+            let now = unsafe { __semantist_vclock_ns() };
+            Duration::from_nanos(now.saturating_sub(self.ns))
+        }
+    }
+
+    /// 0 = RuSTy original (ET > PT), 1 = CODESYS measured (ET >= PT).
+    pub fn timer_semantics() -> u8 {
+        unsafe { __semantist_timer_semantics }
+    }
+}
