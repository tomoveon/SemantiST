diff --git a/src/codegen/semantic.rs b/src/codegen/semantic.rs
new file mode 100644
index 0000000000..f23ee47328
--- /dev/null
+++ b/src/codegen/semantic.rs
@@ -0,0 +1,218 @@
+use std::{collections::BTreeMap, fs, path::Path, sync::OnceLock};
+
+use inkwell::{context::Context, values::InstructionValue};
+use plc_ast::ast::AstNode;
+use serde::{Deserialize, Serialize};
+
+const METADATA_KIND: &str = "semantist.semantic";
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct CodegenMap {
+    schema_version: String,
+    anchors: Vec<CodegenAnchor>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+pub struct CodegenAnchor {
+    pou: String,
+    lowered_ast_id: Option<usize>,
+    kind: AnchorKind,
+    source: Option<SourceSpan>,
+    events: Vec<SemanticEvent>,
+}
+
+#[derive(Clone, Debug, Deserialize)]
+struct SourceSpan {
+    start_offset: usize,
+    end_offset: usize,
+}
+
+#[derive(Clone, Debug, Deserialize, PartialEq, Eq)]
+#[serde(rename_all = "snake_case")]
+pub enum AnchorKind {
+    Conditional,
+    CaseLabel,
+    CaseDefault,
+    LoopBack,
+    ExplicitExit,
+    ExplicitContinue,
+    Return,
+    FunctionEntry,
+    FunctionExit,
+    Hazard,
+}
+
+#[derive(Clone, Debug, Deserialize, Serialize)]
+pub struct SemanticEvent {
+    pub runtime_id: u32,
+    pub stable_id: String,
+    pub semantic_edge_ids: Vec<String>,
+    pub kind: String,
+    pub role: Option<String>,
+    pub hazard: Option<String>,
+    pub violation_predicate: Option<serde_json::Value>,
+    pub successor_hint: Option<u32>,
+    pub modeling: String,
+}
+
+#[derive(Debug, Serialize)]
+struct MetadataPayload<'a> {
+    schema_version: &'static str,
+    pou: &'a str,
+    lowered_ast_id: Option<usize>,
+    events: Vec<SemanticEvent>,
+}
+
+#[derive(Default)]
+struct SemanticIndex {
+    ast: BTreeMap<(String, usize), Vec<CodegenAnchor>>,
+    source: BTreeMap<(String, usize, usize), Vec<CodegenAnchor>>,
+    functions: BTreeMap<String, Vec<CodegenAnchor>>,
+}
+
+static SEMANTIC_INDEX: OnceLock<SemanticIndex> = OnceLock::new();
+
+fn index() -> &'static SemanticIndex {
+    SEMANTIC_INDEX.get_or_init(|| {
+        let Some(path) = std::env::var_os("SEMANTIST_STG_CODEGEN_MAP") else {
+            return SemanticIndex::default();
+        };
+        let bytes = match fs::read(&path) {
+            Ok(bytes) => bytes,
+            Err(error) => {
+                eprintln!(
+                    "STG-IR-E101: cannot read semantic codegen map {}: {error}",
+                    Path::new(&path).display()
+                );
+                return SemanticIndex::default();
+            }
+        };
+        let map = match serde_json::from_slice::<CodegenMap>(&bytes) {
+            Ok(map) => map,
+            Err(error) => {
+                eprintln!(
+                    "STG-IR-E102: cannot parse semantic codegen map {}: {error}",
+                    Path::new(&path).display()
+                );
+                return SemanticIndex::default();
+            }
+        };
+        if map.schema_version != "semantist.codegen-map/1.0.0" {
+            eprintln!("STG-IR-E103: unsupported semantic codegen map schema {}", map.schema_version);
+            return SemanticIndex::default();
+        }
+        let mut index = SemanticIndex::default();
+        for anchor in map.anchors {
+            let pou = anchor.pou.to_ascii_lowercase();
+            if let Some(ast_id) = anchor.lowered_ast_id {
+                index.ast.entry((pou.clone(), ast_id)).or_default().push(anchor.clone());
+            }
+            if let Some(source) = &anchor.source {
+                index
+                    .source
+                    .entry((pou.clone(), source.start_offset, source.end_offset))
+                    .or_default()
+                    .push(anchor.clone());
+            }
+            if anchor.lowered_ast_id.is_none() {
+                index.functions.entry(pou).or_default().push(anchor);
+            }
+        }
+        index
+    })
+}
+
+pub fn events_for_node(pou: &str, node: &AstNode, kind: AnchorKind) -> Vec<SemanticEvent> {
+    let direct = events(pou, node.id, kind.clone());
+    if !direct.is_empty() {
+        return direct;
+    }
+    let Some(range) = node.get_location().to_range() else {
+        return Vec::new();
+    };
+    let mut events = index()
+        .source
+        .get(&(pou.to_ascii_lowercase(), range.start, range.end))
+        .into_iter()
+        .flatten()
+        .filter(|anchor| anchor.kind == kind)
+        .flat_map(|anchor| anchor.events.clone())
+        .collect::<Vec<_>>();
+    events.sort_by_key(|event| (event.successor_hint, event.runtime_id));
+    events.dedup_by_key(|event| (event.successor_hint, event.runtime_id));
+    events
+}
+
+pub fn events(pou: &str, ast_id: usize, kind: AnchorKind) -> Vec<SemanticEvent> {
+    index()
+        .ast
+        .get(&(pou.to_ascii_lowercase(), ast_id))
+        .into_iter()
+        .flatten()
+        .filter(|anchor| anchor.kind == kind)
+        .flat_map(|anchor| anchor.events.clone())
+        .collect()
+}
+
+pub fn function_events(pou: &str, kind: AnchorKind) -> Vec<SemanticEvent> {
+    index()
+        .functions
+        .get(&pou.to_ascii_lowercase())
+        .into_iter()
+        .flatten()
+        .filter(|anchor| anchor.kind == kind)
+        .flat_map(|anchor| anchor.events.clone())
+        .collect()
+}
+
+pub fn attach(
+    context: &Context,
+    instruction: InstructionValue<'_>,
+    pou: &str,
+    ast_id: Option<usize>,
+    events: Vec<SemanticEvent>,
+) {
+    if events.is_empty() {
+        return;
+    }
+    let Ok(payload) = serde_json::to_string(&MetadataPayload {
+        schema_version: "semantist.llvm-semantic/1.0.0",
+        pou,
+        lowered_ast_id: ast_id,
+        events,
+    }) else {
+        return;
+    };
+    let value = context.metadata_string(&payload);
+    let metadata = context.metadata_node(&[value.into()]);
+    let _ = instruction.set_metadata(metadata, context.get_kind_id(METADATA_KIND));
+}
+
+pub fn attach_node(
+    context: &Context,
+    instruction: InstructionValue<'_>,
+    pou: &str,
+    node: &AstNode,
+    kind: AnchorKind,
+) {
+    attach(context, instruction, pou, Some(node.id), events_for_node(pou, node, kind));
+}
+
+pub fn attach_node_and_function(
+    context: &Context,
+    instruction: InstructionValue<'_>,
+    pou: &str,
+    node: &AstNode,
+    node_kind: AnchorKind,
+    function_kind: AnchorKind,
+) {
+    let mut events = events_for_node(pou, node, node_kind);
+    events.extend(function_events(pou, function_kind));
+    events.sort_by_key(|event| (event.successor_hint, event.runtime_id));
+    events.dedup_by_key(|event| (event.successor_hint, event.runtime_id));
+    attach(context, instruction, pou, Some(node.id), events);
+}
+
+pub fn attach_function(context: &Context, instruction: InstructionValue<'_>, pou: &str, kind: AnchorKind) {
+    attach(context, instruction, pou, None, function_events(pou, kind));
+}
