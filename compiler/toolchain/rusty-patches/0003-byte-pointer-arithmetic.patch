diff --git a/tests/lit/single/pointer/byte_pointer_arithmetic.st b/tests/lit/single/pointer/byte_pointer_arithmetic.st
new file mode 100644
index 00000000000..79a395ef6cc
--- /dev/null
+++ b/tests/lit/single/pointer/byte_pointer_arithmetic.st
@@ -0,0 +1,33 @@
+// RUN: (%COMPILE --byte-pointer-arithmetic %s && %RUN) | %CHECK %s
+// With --byte-pointer-arithmetic, integers added to or subtracted from a
+// POINTER TO count bytes (CODESYS: pData[i] := (pData + i * SIZEOF(INT))^).
+// REF_TO keeps element-scaled arithmetic.
+
+FUNCTION main : DINT
+VAR
+    arr : ARRAY[0..3] OF DINT := [10, 20, 30, 40];
+    p : POINTER TO DINT;
+    r : REF_TO DINT;
+    i : DINT := 1;
+END_VAR
+    p := ADR(arr[0]);
+    p := p + SIZEOF(arr[0]);
+    // CHECK: 20
+    printf('%d$N', p^);
+    p := p + i * SIZEOF(arr[0]) * 2;
+    // CHECK: 40
+    printf('%d$N', p^);
+    p := p - 8;
+    // CHECK: 20
+    printf('%d$N', p^);
+    p := 4 + ADR(arr[0]);
+    // CHECK: 20
+    printf('%d$N', p^);
+    r := REF(arr[0]);
+    r := r + 1;
+    // CHECK: 20
+    printf('%d$N', r^);
+    // CHECK: 20
+    printf('%d$N', (REF(arr[0]) + 1)^);
+    main := 0;
+END_FUNCTION
