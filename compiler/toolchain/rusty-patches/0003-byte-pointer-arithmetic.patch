+/// Dialect switch for `POINTER TO` arithmetic (`--byte-pointer-arithmetic`).
+///
+/// Off (the default): `p + n` on any pointer advances by `n` elements, as in C.
+/// On: `p + n` and `p - n` on a `POINTER TO` advance by `n` bytes, which is how
+/// CODESYS-family dialects define it (`pData[i] := (pData + i * SIZEOF(INT))^`);
+/// `REF_TO` and `REFERENCE TO` keep element-scaled arithmetic. The driver sets it
+/// once per compiler invocation before any code is generated.
+static BYTE_POINTER_ARITHMETIC: AtomicBool = AtomicBool::new(false);
+
+pub fn set_byte_pointer_arithmetic(enabled: bool) {
+    BYTE_POINTER_ARITHMETIC.store(enabled, Ordering::Relaxed);
+}
+
+pub fn byte_pointer_arithmetic() -> bool {
+    BYTE_POINTER_ARITHMETIC.load(Ordering::Relaxed)
+}
+
 /// A wrapper around the LLVM context to allow passing it without exposing the inkwell dependencies
 pub struct CodegenContext(Context);
 
