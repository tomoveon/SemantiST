+// RUN: (%COMPILE %s && %RUN) | %CHECK %s
+// Without --byte-pointer-arithmetic, integers added to a POINTER TO count
+// elements of the pointee type, as for REF_TO.
+
+FUNCTION main : DINT
+VAR
+    arr : ARRAY[0..3] OF DINT := [10, 20, 30, 40];
+    p : POINTER TO DINT;
+END_VAR
+    p := ADR(arr[0]);
+    p := p + 1;
+    // CHECK: 20
+    printf('%d$N', p^);
+    p := p + 2;
+    // CHECK: 40
+    printf('%d$N', p^);
+    main := 0;
+END_FUNCTION
