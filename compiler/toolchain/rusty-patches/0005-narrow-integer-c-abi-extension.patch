diff --git a/src/codegen/generators/pou_generator.rs b/src/codegen/generators/pou_generator.rs
index b13cccb72f9..fd54dca87d8 100644
--- a/src/codegen/generators/pou_generator.rs
+++ b/src/codegen/generators/pou_generator.rs
@@ -293,6 +293,36 @@ impl<'ink, 'cg> PouGenerator<'ink, 'cg> {
         let curr_f: FunctionValue<'_> =
             module.add_function(&implementation.get_call_name_for_ir(), function_declaration, None);
 
+        // SemantiST: a function implemented outside the ST sources (the runtime library, C)
+        // follows the C ABI, where an integer parameter narrower than 32 bits is extended by
+        // the caller (x86-64 SysV: clang marks such parameters signext/zeroext and the callee
+        // relies on it). Without the attribute a negative SINT/INT reached e.g.
+        // MUL_TIME__SINT zero-extended. Call sites take the attributes of the declaration.
+        let is_external = self
+            .index
+            .find_pou(implementation.get_call_name())
+            .is_some_and(|pou| pou.get_linkage().is_external_or_included());
+        if is_external && implementation.get_implementation_type() == &ImplementationType::Function {
+            // Variadic members are not fixed parameters of the LLVM declaration.
+            for (i, param) in declared_parameters.iter().enumerate().take(curr_f.count_params() as usize) {
+                if param.is_in_parameter_by_ref() || param.get_declaration_type().is_by_ref() {
+                    continue;
+                }
+                if let DataTypeInformation::Integer { signed, size, .. } =
+                    self.index.get_type_information_or_void(param.get_type_name())
+                {
+                    if *size < 32 {
+                        let kind = if *signed { "signext" } else { "zeroext" };
+                        let attribute = self
+                            .llvm
+                            .context
+                            .create_enum_attribute(inkwell::attributes::Attribute::get_named_enum_kind_id(kind), 0);
+                        curr_f.add_attribute(inkwell::attributes::AttributeLoc::Param(i as u32), attribute);
+                    }
+                }
+            }
+        }
+
         let section_name = self.get_section(implementation)?;
         curr_f.set_section(section_name.as_deref());
 
