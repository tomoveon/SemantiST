diff --git a/tests/lit/single/arithmetic/mul_time_narrow_signed.st b/tests/lit/single/arithmetic/mul_time_narrow_signed.st
new file mode 100644
index 00000000000..3c3b542af8b
--- /dev/null
+++ b/tests/lit/single/arithmetic/mul_time_narrow_signed.st
@@ -0,0 +1,24 @@
+// RUN: (%COMPILE %s && %RUN) | %CHECK %s
+// A negative SINT/INT passed to a runtime function with an 8- or 16-bit
+// parameter keeps its sign: through the typed variadic MUL (the integer is
+// extended in the variadic call) and through MUL_TIME (the declaration
+// carries signext/zeroext as in the C ABI).
+
+FUNCTION main : DINT
+VAR
+    s : SINT := -120;
+    i : INT := -3600;
+    u : USINT := 200;
+END_VAR
+    // CHECK: -10368000000000000
+    printf('%lld$N', TIME_TO_LINT(MUL(TIME#1d, s)));
+    // CHECK: -3600000000000
+    printf('%lld$N', TIME_TO_LINT(MUL_TIME(TIME#1s, i)));
+    // CHECK: -10368000000000000
+    printf('%lld$N', LTIME_TO_LINT(MUL_LTIME(LTIME#1d, s)));
+    // CHECK: 200000000
+    printf('%lld$N', TIME_TO_LINT(MUL_TIME(TIME#1ms, u)));
+    // CHECK: -7000000000
+    printf('%lld$N', TIME_TO_LINT(MUL(TIME#1s, SINT#-7)));
+    main := 0;
+END_FUNCTION
