diff --git a/tests/lit/single/pointer/adr_integer_arithmetic.st b/tests/lit/single/pointer/adr_integer_arithmetic.st
new file mode 100644
index 00000000000..06ccafdb4d5
--- /dev/null
+++ b/tests/lit/single/pointer/adr_integer_arithmetic.st
@@ -0,0 +1,32 @@
+// RUN: (%COMPILE %s && %RUN) | %CHECK %s
+// `ADR(x)` yields an LWORD address. Integer arithmetic on it, assigned directly
+// to a pointer or compared, must compile and count bytes (it used to panic in
+// codegen: "expected the IntValue variant").
+
+FUNCTION main : DINT
+VAR
+    arr : ARRAY[0..2] OF DINT := [10, 20, 30];
+    text : STRING[10] := 'abc';
+    p : POINTER TO DINT;
+    c : POINTER TO BYTE;
+    a : LWORD;
+END_VAR
+    p := ADR(arr) + 4;
+    // CHECK: 20
+    printf('%d$N', p^);
+    p := ADR(arr[2]) - 8;
+    // CHECK: 10
+    printf('%d$N', p^);
+    c := ADR(text) + 1;
+    // CHECK: 98
+    printf('%d$N', c^);
+    a := ADR(arr) + SIZEOF(arr[0]) * 2;
+    p := a;
+    // CHECK: 30
+    printf('%d$N', p^);
+    IF ADR(arr) + 4 = ADR(arr[1]) THEN
+        // CHECK: equal
+        printf('equal$N');
+    END_IF
+    main := 0;
+END_FUNCTION
